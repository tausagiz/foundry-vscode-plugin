{
  "name": "foundry-local-copilot",
  "displayName": "Foundry Local Copilot",
  "description": "Local coding assistance for VS Code powered by Microsoft Foundry Local.",
  "version": "0.0.4",
  "private": true,
  "publisher": "local-development",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/local-development/foundry-local-copilot"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "foundryLocal.explainSelection",
        "title": "Foundry Local: Explain Selection"
      },
      {
        "command": "foundryLocal.openChat",
        "title": "Foundry Local: Open Chat"
      },
      {
        "command": "foundryLocal.openMenu",
        "title": "Foundry Local: Quick Menu"
      },
      {
        "command": "foundryLocal.selectModel",
        "title": "Foundry Local: Select Model",
        "icon": "$(chip)"
      },
      {
        "command": "foundryLocal.fixSelection",
        "title": "Foundry Local: Fix Selection"
      },
      {
        "command": "foundryLocal.toggleInlineCompletions",
        "title": "Foundry Local: Toggle Inline Completions"
      },
      {
        "command": "foundryLocal.showOutput",
        "title": "Foundry Local: Show Output"
      },
      {
        "command": "foundryLocal.selectMode",
        "title": "Foundry Local: Select Chat Mode",
        "icon": "$(list-selection)"
      },
      {
        "command": "foundryLocal.configureParameters",
        "title": "Foundry Local: Configure Parameters",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "foundryLocal.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "foundryLocal.fixSelection",
          "when": "editorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "foundryLocal.openChat",
          "when": "true"
        },
        {
          "command": "foundryLocal.selectModel",
          "when": "true"
        },
        {
          "command": "foundryLocal.selectMode",
          "when": "true"
        },
        {
          "command": "foundryLocal.configureParameters",
          "when": "true"
        }
      ],
      "workbench/chat/title": [
        {
          "command": "foundryLocal.selectModel",
          "group": "navigation",
          "when": "chatParticipant == 'foundry-local-copilot.participant'"
        },
        {
          "command": "foundryLocal.selectMode",
          "group": "navigation",
          "when": "chatParticipant == 'foundry-local-copilot.participant'"
        },
        {
          "command": "foundryLocal.configureParameters",
          "group": "navigation",
          "when": "chatParticipant == 'foundry-local-copilot.participant'"
        }
      ]
    },
    "codeActionsProviders": [
      {
        "languages": [
          "*"
        ],
        "providedCodeActionKinds": [
          "quickfix"
        ]
      }
    ],
    "chatParticipants": [
      {
        "id": "foundry-local-copilot.participant",
        "name": "foundry-local",
        "fullName": "Foundry Local",
        "description": "Ask a local model about your code and workspace",
        "isSticky": true,
        "commands": [
          {
            "name": "ask",
            "description": "Answer the question using the current editor context"
          },
          {
            "name": "plan",
            "description": "Create an implementation plan without changing files"
          },
          {
            "name": "explain",
            "description": "Explain the current code or selection"
          },
          {
            "name": "fix",
            "description": "Suggest a fix for the current code or diagnostics"
          },
          {
            "name": "refactor",
            "description": "Refactor the current selection"
          },
          {
            "name": "tests",
            "description": "Generate tests for the current code"
          },
          {
            "name": "agent",
            "description": "Inspect the workspace and complete a coding task with confirmed tools"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "foundryLocal_readFile",
        "displayName": "Read workspace file",
        "modelDescription": "Reads a text file from the current workspace using a workspace-relative path.",
        "description": "Read a text file from the current workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "foundryLocal_searchWorkspace",
        "displayName": "Search workspace",
        "modelDescription": "Searches text in workspace files and returns matching file paths and lines.",
        "description": "Search text in files in the current workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Case-insensitive text to search for."
            },
            "include": {
              "type": "string",
              "description": "Optional glob such as **/*.ts."
            },
            "maxResults": {
              "type": "number",
              "description": "Maximum matching lines, up to 100."
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "foundryLocal_getDiagnostics",
        "displayName": "Get diagnostics",
        "modelDescription": "Reads VS Code diagnostics for the active file or a workspace-relative file.",
        "description": "Read VS Code diagnostics for the active file or a workspace-relative file.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Optional workspace-relative file path."
            }
          }
        }
      },
      {
        "name": "foundryLocal_proposeEdits",
        "displayName": "Propose workspace edits",
        "modelDescription": "Proposes validated multi-file workspace edits. Applying them requires explicit user confirmation.",
        "description": "Prepare validated workspace edits and apply them after user confirmation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "description": "Short summary of the proposed changes."
            },
            "edits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string"
                  },
                  "start": {
                    "type": "object"
                  },
                  "end": {
                    "type": "object"
                  },
                  "newText": {
                    "type": "string"
                  }
                },
                "required": [
                  "uri",
                  "start",
                  "end",
                  "newText"
                ]
              }
            }
          },
          "required": [
            "edits"
          ]
        }
      },
      {
        "name": "foundryLocal_runTests",
        "displayName": "Run workspace validation",
        "modelDescription": "Runs the fixed npm test or compile script in the current workspace after user confirmation.",
        "description": "Run npm test or npm run compile in the workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "script": {
              "type": "string",
              "enum": [
                "test",
                "compile"
              ]
            }
          }
        }
      },
      {
        "name": "foundryLocal_runCommand",
        "displayName": "Run allowed workspace command",
        "modelDescription": "Runs only npm test, npm run compile, or git status --short in the trusted workspace after explicit user confirmation.",
        "description": "Run one of the fixed, confirmation-gated workspace commands.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "enum": ["npm test", "npm run compile", "git status --short"]
            }
          },
          "required": ["command"]
        }
      }
    ],
    "configuration": {
      "title": "Foundry Local Copilot",
      "properties": {
        "foundryLocal.inlineCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Enable local inline code completions."
        },
        "foundryLocal.modelAlias": {
          "type": "string",
          "default": "qwen2.5-coder-0.5b",
          "description": "Foundry Local model alias."
        },
        "foundryLocal.autoDownload": {
          "type": "boolean",
          "default": true,
          "description": "Download the selected model into the SDK cache when it is not available locally."
        },
        "foundryLocal.maxOutputTokens": {
          "type": "number",
          "default": 512,
          "minimum": 64,
          "maximum": 4096,
          "description": "Maximum number of generated tokens for chat requests."
        },
        "foundryLocal.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for local model requests."
        },
        "foundryLocal.maxContextCharacters": {
          "type": "number",
          "default": 24000,
          "minimum": 2000,
          "maximum": 100000,
          "description": "Maximum number of source characters included in a request."
        },
        "foundryLocal.inlineDebounceMs": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 1000,
          "description": "Delay before requesting an inline completion after typing."
        },
        "foundryLocal.maxInlineCompletionCharacters": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "maximum": 50000,
          "description": "Maximum source characters sent for an inline completion."
        },
        "foundryLocal.autoSelectModel": {
          "type": "boolean",
          "default": true,
          "description": "Use the first available local chat model when no model alias is configured."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:foundry-local-sdk --outfile=dist/extension.js",
    "watch": "tsc -p ./tsconfig.json --watch",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "package": "npm run bundle && vsce package"
  },
  "dependencies": {
    "@vscode/chat-extension-utils": "^0.0.0-alpha.5",
    "foundry-local-sdk": "1.2.4",
    "foundry-local-sdk-winml": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.4.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "foundry-local-sdk-winml@1.2.4": true,
    "foundry-local-sdk@1.2.4": true
  }
}
